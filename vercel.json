{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/health",              "destination": "/api/index" },
    { "source": "/v1/:path*",           "destination": "/api/index" },
    { "source": "/((?!api/).*)",        "destination": "/index.html" }
  ]
}
